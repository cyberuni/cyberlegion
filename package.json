{
	"name": "cyberlegion-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"check:bundle": "node scripts/check-cli-bundle.mjs",
		"check:suite": "node scripts/check-suite.mjs",
		"cl": "pnpm run --filter=./packages/cyberlegion",
		"knip": "knip",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "pnpm check && pnpm check:suite && turbo run build typecheck test && pnpm check:bundle && pnpm knip",
		"version": "changeset version && node scripts/sync-plugin-version.mjs && universal-plugin plugin build --root packages/cyberlegion",
		"web": "turbo run --filter=@cyberuni/web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.1",
		"cyber-sdd": "0.4.0",
		"husky": "^9.1.7",
		"knip": "^6.31.0",
		"tsx": "^4.23.12",
		"turbo": "^2.10.8",
		"universal-plugin": "^0.9.0"
	},
	"packageManager": "pnpm@11.28.0+sha512.8ed239371de82244b6cccf9e2023c18ea8439961f2ec3fe898913b9f7ee2e76ca0a45717580aca3c7997c135f6d4f5de4524cbeee1a2ccac430c03d134e2a48c",
	"engines": {
		"node": ">=22.11"
	}
}
