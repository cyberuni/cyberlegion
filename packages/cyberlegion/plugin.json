{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "cyberlegion",
	"version": "2.2.1",
	"description": "Agent session spawning, messaging, and dispatch — the Legion and its Legate.",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/cyberlegion",
	"repository": "https://github.com/cyberuni/cyberlegion",
	"keywords": ["agent", "dispatch", "inter-agent", "multiplexer"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"vendors": ["claude-code", "codex"],
			"skills": "./skills",
			"agents": ["./agents/headless-legate.md"],
			"hooks": "./hooks/hooks.json",
			"harnesses": {
				"claude-code": {},
				"codex": {}
			},
			"scripts": {
				"skills/dispatch-governance/scripts/cyberlegion.mjs": { "forward": "cyberlegion" },
				"skills/init-cyberlegion/scripts/cyberlegion.mjs": { "forward": "cyberlegion" },
				"skills/legate/scripts/cyberlegion.mjs": { "forward": "cyberlegion" },
				"skills/manage-inbox/scripts/cyberlegion.mjs": { "forward": "cyberlegion" },
				"skills/relay-governance/scripts/cyberlegion.mjs": { "forward": "cyberlegion" },
				"skills/subagent-backend-governance/scripts/cyberlegion.mjs": { "forward": "cyberlegion" }
			}
		}
	}
}
