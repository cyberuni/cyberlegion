{
	"name": "cyberlegion",
	"version": "1.5.0",
	"description": "Harness-agnostic agent session spawning and messaging over the filesystem",
	"keywords": [
		"agent",
		"claude-code",
		"cursor",
		"codex",
		"inter-agent",
		"tmux"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberuni/cyberlegion.git",
		"directory": "packages/cyberlegion"
	},
	"license": "MIT",
	"author": "unional <homawong@gmail.com>",
	"type": "module",
	"bin": {
		"cyberlegion": "bin/cyberlegion.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"dist",
		"plugin.json",
		".claude-plugin",
		".codex-plugin",
		".plugin",
		"skills",
		"hooks",
		"agents"
	],
	"scripts": {
		"build": "tsdown",
		"check:metaphor-free": "tsx src/check-metaphor-free.ts",
		"dev": "tsx src/dev.ts",
		"test": "vitest run src",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@cyberuni/agent-harness": "^0.6.0",
		"commander": "^15.0.0",
		"cyber-mux": "0.9.1"
	},
	"peerDependencies": {
		"cynapse": "^0.1.0"
	},
	"peerDependenciesMeta": {
		"cynapse": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"cynapse": "0.1.0",
		"smol-toml": "^1.8.0",
		"tsdown": "^0.23.0",
		"tsx": "^4.22.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
