registry=https://registry.npmjs.org

# Supply-chain soak: refuse packages published less than 24h ago, so a compromised
# release has a window to be caught and unpublished before it reaches a build.
# Mirrors `minimumReleaseAge` in the renovate preset, which shortens it to 1 day
# for vulnerability alerts rather than to zero.
minimumreleaseage=1440
